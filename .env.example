# 复制成 .env 后按需修改：cp .env.example .env
#
# docker compose 会自动读取同目录的 .env。

# 宿主机端口（容器内固定 3000）
HOST_PORT=3222

# 时区，只影响日志里的时间
TZ=Asia/Shanghai

# 盘面在内存里空闲多久就卸载（毫秒）。
# 卸载**不删数据** —— 下次有人进房间会重新从盘上读回来。
# 弱服务器（内存小）可以调小，比如 120000（2 分钟）。
BOARD_IDLE_MS=600000

# ---- 可选：启用 HTTPS 反代（--profile tls）时需要 --------------------
#
# 一个指向本机的域名。Caddy 会自动申请并续期证书。
# 留空或 localhost 的话 Caddy 用自签证书（浏览器会警告，仅供测试）。
# SITE_ADDRESS=table.example.com
